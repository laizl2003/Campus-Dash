{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@agent/*": ["../agent/agent-frontend/src/*"],
      "@app/*": ["src/*"],
      "react": ["node_modules/@types/react", "node_modules/react"],
      "react/jsx-runtime": ["node_modules/@types/react/jsx-runtime", "node_modules/react/jsx-runtime"],
      "react-dom": ["node_modules/@types/react-dom", "node_modules/react-dom"]
    },
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "../agent/agent-frontend/src"]
}
